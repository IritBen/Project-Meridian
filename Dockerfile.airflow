FROM apache/airflow:3.3.2-python3.13

ARG JUST_VERSION=1.59.0

USER root

# Copy Docker CLI and Compose v2 from the official Docker image.
COPY --from=docker:27-cli \
    /usr/local/bin/docker \
    /usr/local/bin/docker

COPY --from=docker:27-cli \
    /usr/local/libexec/docker/cli-plugins/docker-compose \
    /usr/local/libexec/docker/cli-plugins/docker-compose

RUN docker --version && docker compose version

WORKDIR /opt/airflow/meridian

COPY --chown=airflow:root pyproject.toml uv.lock ./
COPY --chown=airflow:root src/ ./src/

USER airflow

# Install Meridian's Python package and dependencies into the same
# Python environment used by Airflow.
RUN pip install \
    --no-cache-dir \
    --constraint "${HOME}/constraints.txt" \
    "apache-airflow==${AIRFLOW_VERSION}" \
    apache-airflow-providers-fab \
    "rust-just==${JUST_VERSION}" \
    .